# TIME AND SPACE COMPLEXITY 

# O(1) - Constant Time
def constant_time(arr):
    return arr[0]

# O(log n) - Logarithmic Time
def logarithmic_time(n):
    while n > 1:
        n = n // 2

# O(n) - Linear Time
def linear_time(arr):
    for x in arr:
        print(x)

# O(n log n) - Linearithmic Time
def linearithmic_time(arr):
    arr.sort()       

# O(n²) - Quadratic Time
def quadratic_time(arr):
    for i in range(len(arr)):
        for j in range(len(arr)):
            print(arr[i], arr[j])

# O(n) Space
def linear_space(n):
    values = []
    for i in range(n):
        values.append(i)
    return values

# O(1) Auxiliary Space
def constant_space(arr):
    total = 0
    for x in arr:
        total += x
    return total

# O(n²) Space
def quadratic_space(n):
    matrix = [[0] * n for _ in range(n)]
    return matrix

# Recursion - O(n) Space
def recursive_function(n):
    if n == 0:
        return
    recursive_function(n - 1)

# Example of Time + Space Complexity

def example(arr):
    seen = set()

    for x in arr:
        seen.add(x)

    return seen

# Time: O(n)
# Auxiliary Space: O(n)
